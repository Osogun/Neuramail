{
  "name": "neuramail",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "npx concurrently \"npm:dev:react\" \"npm:dev:electron\"",
    "dev:react": "NODE_OPTIONS=--openssl-legacy-provider npm run dev --prefix frontend",
    "dev:electron": "npx wait-on http://localhost:5173 && electron .",
    "build": "npm run build --prefix frontend && electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
